{
    "manifest_version": 3,
    "name": "HueHawk",
    "version": "1.0.0",
    "description": "Extract and copy color palettes from any website.",
    "permissions": ["activeTab", "scripting"],
    "host_permissions": ["<all_urls>"],
    "action": {
      "default_popup": "index.html"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
      }
    ]
  }
  